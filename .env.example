# Local 환경 설정 예시
# 실제 키 값은 이 파일을 복사하여 .env로 저장하고, Git에 커밋하지 마세요.

# 필수
NEMC_HOSPITAL_API_KEY=your_nemc_hospital_api_key

# 선택 (자연어 설명 — 없으면 규칙 기반 폴백). 무료 발급: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-1.5-flash

OSRM_URL=http://router.project-osrm.org
PORT=5000
